{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "{plataforma/src/**,packages/dnc/**,packages/dc3/**,packages/xlsb/**,packages/contracts/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
