{
  "name": "kcm-capacitacion-ocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:ocr": "node --test tests/unit/ocr*.test.js",
    "test:load": "node scripts/run-load-test.js",
    "lint": "node scripts/check-project.js",
    "demo": "node scripts/run-vertical-demo.js",
    "metrics:ocr": "node scripts/measure-ocr.js",
    "metrics:normalization": "node scripts/measure-normalization.js",
    "metrics:ocr:local": "node scripts/measure-local-ocr.js",
    "metrics:ocr:compare": "node scripts/compare-local-ocr-providers.js",
    "evidence:ocr": "node scripts/measure-local-ocr.js --write-artifacts",
    "evidence:ocr:compare": "node scripts/compare-local-ocr-providers.js --write-report",
    "smoke:ocr-worker": "node scripts/smoke-ocr-worker.js",
    "preview:ocr": "node scripts/serve-local-preview.js",
    "preview:platform": "node scripts/serve-platform-preview.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  }
}
