{
  "name": "kcm-cap",
  "version": "1.0.0",
  "description": "Plataforma de administración de capacitación para Kimberly-Clark de México, planta Ecatepec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "npm run test && npm run test:plataforma && npm run typecheck && npm run check:proyecto && npm run check:vba && npm run check:imagen && npm run lint && npm run format:check",

    "start": "node --env-file-if-exists=.env plataforma/src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env plataforma/src/main.ts",

    "test": "node --test packages/tests/unit/*.test.js packages/tests/integration/*.test.js",
    "test:unit": "node --test packages/tests/unit/*.test.js",
    "test:integration": "node --test packages/tests/integration/*.test.js",
    "test:plataforma": "node --test plataforma/tests/**/*.test.ts",

    "typecheck": "tsc --noEmit --project plataforma/tsconfig.json",
    "lint": "eslint plataforma",
    "format": "prettier --write plataforma",
    "format:check": "prettier --check plataforma",
    "check:proyecto": "node tools/check/proyecto.js",
    "check:vba": "node tools/check/vba.js",
    "check:imagen": "node tools/check/imagen.js",

    "docker:up": "docker compose -f infra/compose.yaml up",
    "docker:down": "docker compose -f infra/compose.yaml down",
    "docker:limpiar": "docker compose -f infra/compose.yaml down --volumes",
    "docker:reconstruir": "docker compose -f infra/compose.yaml build --no-cache && docker compose -f infra/compose.yaml up --force-recreate",
    "docker:consola": "docker compose -f infra/compose.yaml exec plataforma bash",
    "docker:psql": "docker compose -f infra/compose.yaml exec base psql -U postgres -d kcm",

    "db:migrar": "node --env-file-if-exists=.env tools/db/aplicar-migraciones.js",
    "db:reset": "node --env-file-if-exists=.env tools/db/reset-base.js",
    "db:cuenta": "node --env-file-if-exists=.env tools/db/alta-cuenta-consola.js",
    "db:padron": "node --env-file-if-exists=.env tools/db/cargar-padron.js",

    "build:semilla-catalogo": "node tools/build/semilla-catalogo.js",
    "build:mapeo-matriz": "node tools/build/mapeo-matriz.js",
    "build:catalogo-ocupaciones": "node tools/build/catalogo-ocupaciones.js",
    "extraer:hc": "node packages/xlsb/extract-hc-xlsb.js",

    "ia:ocupaciones": "node --env-file-if-exists=.env plataforma/src/cli/probar-ocupaciones.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.18",
    "fastify": "5.11.0",
    "pg": "^8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "^8.20.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
